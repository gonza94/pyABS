Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Calculate", " ", "solution", " ", "to", " ", "theta", " ", "wake"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"unm", "[", 
     RowBox[{"n_Integer", ",", "m_Integer"}], "]"}], ":=", 
    RowBox[{"Which", "[", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"both", " ", "zero"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"m", "==", "0"}], "&&", 
       RowBox[{"n", "==", "0"}]}], ",", 
      RowBox[{"1.", "/", "2."}], ",", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"main", " ", "diagonal", " ", "m"}], "=", 
        RowBox[{"n", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"covers", " ", "n"}], "\[NotEqual]", "0"}], ")"}], 
         "integral", " ", "is", " ", "0"}]}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"m", "==", "n"}], ",", "0", ",", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"anti", "-", 
         RowBox[{"diagonal", " ", "m"}]}], "=", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "n"}], " ", "with", " ", "n"}], "\[NotEqual]", 
         RowBox[{"0", " ", "also", " ", "0"}]}]}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"m", "==", 
        RowBox[{"-", "n"}]}], "&&", 
       RowBox[{"n", "=!=", "0"}]}], ",", "0", ",", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"m", "=", "0"}], ",", 
        RowBox[{
         RowBox[{"n", "\[NotEqual]", "0"}], ":", 
         RowBox[{"special", " ", "closed", " ", "form"}]}]}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"m", "==", "0"}], ",", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"(", 
         RowBox[{"1.", "-", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"-", "1."}], ")"}], "^", "n"}]}], ")"}]}], "/", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"Pi", " ", "n"}], ")"}], "^", "2."}], ")"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"generic", " ", 
        RowBox[{"case", ":", 
         RowBox[{"m", "\[NotEqual]", 
          RowBox[{"0", " ", "and", " ", "m"}], "\[NotEqual]", 
          RowBox[{"\[PlusMinus]", "n"}]}]}]}], "*)"}], "\[IndentingNewLine]", 
      "True", ",", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1.", "/", 
         RowBox[{"(", 
          RowBox[{"2.", " ", 
           RowBox[{"Pi", "^", "2."}], " ", "m"}], ")"}]}], ")"}], "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1.", "-", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"-", "1."}], ")"}], "^", 
             RowBox[{"(", 
              RowBox[{"m", "+", "n"}], ")"}]}]}], ")"}], "/", 
          RowBox[{"(", 
           RowBox[{"m", "+", "n"}], ")"}]}], "+", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1.", "-", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"-", "1."}], ")"}], "^", 
             RowBox[{"(", 
              RowBox[{"m", "-", "n"}], ")"}]}]}], ")"}], "/", 
          RowBox[{"(", 
           RowBox[{"m", "-", "n"}], ")"}]}]}], ")"}]}]}], "]"}]}], 
   ";"}]}]], "Input",
