          RowBox[{
           RowBox[{"xlcentroid", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "/.", 
           RowBox[{"\[Theta]", "->", "0"}]}], ")"}], "*", 
         RowBox[{"Exp", "[", 
          RowBox[{
