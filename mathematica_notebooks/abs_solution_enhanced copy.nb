Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Build", " ", "ABS", " ", "eigenfunctions"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"xl", " ", "=", " ", 
     RowBox[{"Dot", "[", 
      RowBox[{"sols", ",", "azimuthalsols"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"cosBasis", "=", 
     RowBox[{"Cos", "[", 
      RowBox[{"nvec", "*", "\[Psi]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"xlcentroid", "=", 
     RowBox[{"sols", ".", "cosBasis"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ns", " ", "=", " ", "20"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"xlcentroidstrobe", " ", "=", " ", 
     RowBox[{"ParallelTable", "[", 
      RowBox[{
       RowBox[{"Re", "[", 
