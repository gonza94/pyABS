Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Get", " ", "solutions", " ", "and", " ", "multiply", " ", "by", " ", 
    "arbitrary", " ", "constant", " ", "tbd", " ", "from", " ", "initial", " ",
     "conditions"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "Matrix", " ", "whose", " ", "columns", " ", "are", " ", "eigenvectors", " ",
      "in", " ", "n"}], "-", "basis"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"sols", " ", "=", " ", 
     RowBox[{
      RowBox[{"Exp", "[", 
       RowBox[{"sortedVals", "*", "\[Theta]"}], "]"}], "*", "sortedVecs"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Vmat", "=", 
     RowBox[{"Transpose", "[", "sortedVecs", "]"}]}], ";"}], "              ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"N", " ", "x", " ", "N"}], ",", 
     RowBox[{"N", "=", 
      RowBox[{
       RowBox[{"2", "*", "size"}], "+", "1"}]}]}], "*)"}], "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "target", " ", "Fourier", " ", "coefficients", " ", "for", " ", "x", 
      RowBox[{"(", "\[Psi]", ")"}]}], "=", 
     RowBox[{
      RowBox[{"1", ":", 
       RowBox[{"only", " ", "n"}]}], "=", 
      RowBox[{"0", " ", "is", " ", "1"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"target", "=", 
     RowBox[{"UnitVector", "[", 
      RowBox[{
       RowBox[{"Length", "[", "Vmat", "]"}], ",", 
       RowBox[{"size", "+", "1"}]}], "]"}]}], ";"}], "  ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"index", " ", "size"}], "+", 
      RowBox[{"1", " ", "corresponds", " ", "to", " ", "n"}]}], "=", "0"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Solve", " ", "for", " ", "alpha", " ", "numerically", " ", 
     RowBox[{"(", "FAST", ")"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"alphaVec", "=", 
     RowBox[{"LinearSolve", "[", 
      RowBox[{
       RowBox[{"N", "@", "Vmat"}], ",", 
       RowBox[{"N", "@", "target"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   
   RowBox[{"(*", 
    RowBox[{
    "Now", " ", "use", " ", "alphaVec", " ", "instead", " ", "of", " ", 
     "NSolve", " ", "rules"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"antheta", "=", 
     RowBox[{"Total", "[", 
      RowBox[{
       RowBox[{"sols", "*", "alphaVec"}], ",", 
       RowBox[{"{", "1", "}"}]}], "]"}]}], ";"}], "\n"}]}]], "Input",
