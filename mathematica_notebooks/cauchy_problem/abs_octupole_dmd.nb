           RowBox[{"(", 
            RowBox[{"b", "*", 
             RowBox[{"(", 
              RowBox[{"\[Lambda]", "^", "j"}], ")"}]}], ")"}]}]}]}], "}"}], ",", 
       RowBox[{
        RowBox[{"Norm", "[", 
         RowBox[{"yhat", "-", "ytrue"}], "]"}], "/", 
        RowBox[{"Norm", "[", "ytrue", "]"}]}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "0", ",", "jmax"}], "}"}]}], "]"}]}], ";"}]}], "Input",\

 CellLabel->"In[72]:=",ExpressionUUID->"7ed7a207-759f-43dc-ba8e-8f7dc828f31b"],

