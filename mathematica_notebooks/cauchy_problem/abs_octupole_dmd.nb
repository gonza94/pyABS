Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"--", 
     RowBox[{"--", "Look"}]}], " ", "at", " ", "importance", " ", "of", " ", 
    RowBox[{
     RowBox[{"modes", "--"}], "--"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"impA", "=", 
     RowBox[{
      RowBox[{"Abs", "[", "b", "]"}], "*", 
      RowBox[{"(", 
       RowBox[{"Norm", "/@", 
        RowBox[{"Transpose", "[", "\[CapitalPhi]a", "]"}]}], ")"}]}]}], ";"}],
    "          ", 
   RowBox[{"(*", 
    RowBox[{"length", " ", "r"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"impASorted", "=", 
     RowBox[{"Reverse", "@", 
      RowBox[{"Sort", "[", "impA", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"kordered", " ", "=", " ", 
     RowBox[{"Reverse", "[", 
      RowBox[{"Ordering", "[", "impA", "]"}], "]"}]}], ";"}]}]}]], "Input",
 CellLabel->"In[76]:=",ExpressionUUID->"403d9b7c-28cc-4524-830d-a34bf0993914"],

