 RowBox[{
  RowBox[{
   RowBox[{"\[CapitalPhi]a", "=", 
    RowBox[{"\[CapitalPhi]", "[", 
     RowBox[{"[", 
      RowBox[{
       RowBox[{"1", ";;", "n"}], ",", "All"}], "]"}], "]"}]}], ";"}], 
