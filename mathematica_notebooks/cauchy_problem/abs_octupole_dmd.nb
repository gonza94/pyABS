Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"Ufull", ",", "\[CapitalSigma]full", ",", "Vfull"}], "}"}], "=", 
   RowBox[{"SingularValueDecomposition", "[", "Y1", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Sigma]y", "=", 
   RowBox[{"Diagonal", "[", "\[CapitalSigma]full", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"cum", "=", 
   RowBox[{
    RowBox[{"Accumulate", "[", 
     RowBox[{"\[Sigma]y", "^", "2"}], "]"}], "/", 
    RowBox[{"Total", "[", 
     RowBox[{"\[Sigma]y", "^", "2"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{"r", "=", 
  RowBox[{"First", "@", 
   RowBox[{"FirstPosition", "[", 
    RowBox[{"cum", ",", 
     RowBox[{"_", "?", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"#", ">=", "0.9999999"}], "&"}], ")"}]}]}], 
    "]"}]}]}]}], "Input",
 CellLabel->"In[48]:=",ExpressionUUID->"350dc6fe-f8cd-42f1-bf9c-6918640d89a5"],

