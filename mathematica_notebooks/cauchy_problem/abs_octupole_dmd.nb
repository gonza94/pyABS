Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"--", 
     RowBox[{"--", "snapshot"}]}], " ", "times", " ", "in", " ", 
    RowBox[{
     RowBox[{"theta", "--"}], "--"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"\[Theta]0", "=", 
     RowBox[{"5.", "Pi"}]}], ";", 
    RowBox[{"\[Theta]1", "=", 
     RowBox[{"20.", " ", "Pi"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"m", "=", "1000"}], ";"}], "                         ", 
   RowBox[{"(*", 
    RowBox[{"number", " ", "of", " ", "snapshots"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"\[Theta]list", "=", 
     RowBox[{"Subdivide", "[", 
      RowBox[{"\[Theta]0", ",", "\[Theta]1", ",", 
       RowBox[{"m", "-", "1"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"\[CapitalDelta]\[Theta]", "=", 
     RowBox[{
      RowBox[{"\[Theta]list", "[", 
       RowBox[{"[", "2", "]"}], "]"}], "-", 
      RowBox[{"\[Theta]list", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"yVec", "[", 
      RowBox[{"\[Theta]_", "?", "NumericQ"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"y", "=", 
          RowBox[{"solY", "[", "\[Theta]", "]"}]}], ",", "a", ",", "d"}], 
        "}"}], ",", 
       RowBox[{
        RowBox[{"a", "=", 
         RowBox[{"y", "[", 
          RowBox[{"[", 
           RowBox[{"1", ";;", "n"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"d", "=", 
         RowBox[{"y", "[", 
          RowBox[{"[", 
           RowBox[{
            RowBox[{"n", "+", "1"}], ";;", 
            RowBox[{"2", " ", "n"}]}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"d", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "=", "0."}], ";", 
        RowBox[{
         RowBox[{"d", "[", 
          RowBox[{"[", 
           RowBox[{"-", "1"}], "]"}], "]"}], "=", "0."}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Join", "[", 
         RowBox[{"a", ",", "d"}], "]"}]}]}], "                 ", 
      RowBox[{"(*", 
       RowBox[{"size", " ", "2", "n"}], "*)"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Y", "=", 
     RowBox[{"Transpose", "@", 
      RowBox[{"(", 
       RowBox[{"yVec", "/@", "\[Theta]list"}], ")"}]}]}], ";"}], "   ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"2", "n"}], ")"}], " ", "x", " ", "m"}], "*)"}]}]}]], "Input",
 CellLabel->"In[40]:=",ExpressionUUID->"3d3ae677-37cc-4deb-949e-e2aa38ddc3e7"],

