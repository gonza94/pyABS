Cell[BoxData[{
 RowBox[{
  RowBox[{"jmax", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"Dimensions", "[", "Y", "]"}], "[", 
     RowBox[{"[", "2", "]"}], "]"}], "-", "1"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"errs", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"ytrue", "=", 
          RowBox[{"Y", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", 
             RowBox[{"j", "+", "1"}]}], "]"}], "]"}]}], ",", 
         RowBox[{"yhat", "=", 
