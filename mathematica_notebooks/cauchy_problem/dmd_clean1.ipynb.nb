Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"--", 
     RowBox[{"--", "Look"}]}], " ", "at", " ", "importance", " ", "of", " ", 
    RowBox[{
     RowBox[{"modes", "--"}], "--"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"impA", "=", 
     RowBox[{
      RowBox[{"Abs", "[", "b", "]"}], "*", 
      RowBox[{"(", 
       RowBox[{"Norm", "/@", 
        RowBox[{"Transpose", "[", "\[CapitalPhi]a", "]"}]}], ")"}]}]}], ";"}],
    "          ", 
   RowBox[{"(*", 
    RowBox[{"length", " ", "r"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"impASorted", "=", 
     RowBox[{"Reverse", "@", 
      RowBox[{"Sort", "[", "impA", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"kordered", " ", "=", " ", 
     RowBox[{"Reverse", "[", 
      RowBox[{"Ordering", "[", "impA", "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"ListLinePlot", "[", 
    RowBox[{
     RowBox[{"Transpose", "@", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Range", "[", "r", "]"}], ",", "impA"}], "}"}]}], ",", 
     RowBox[{"PlotRange", "->", "All"}], ",", 
     RowBox[{"ScalingFunctions", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<Linear\>\"", ",", "\"\<Log\>\""}], "}"}]}], ",", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<DMD Index k\>\"", 
        ",", "\"\<Importance in reconstruction\>\""}], "}"}]}]}], 
    "]"}]}]}]], "Input",
