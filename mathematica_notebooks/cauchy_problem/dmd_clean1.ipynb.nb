          RowBox[{"-", "1"}], "]"}], "]"}], "=", "0."}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"as", "=", 
        RowBox[{"Ds", "[", "a", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"ds1", "=", 
        RowBox[{"Ds", "[", "d", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"F", "=", 
        RowBox[{"FfromA", "[", "a", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "/", 
             RowBox[{"(", 
              RowBox[{"2", " ", "Pi"}], ")"}]}], ")"}], " ", "ds1"}], "+", 
          RowBox[{"I", " ", "F"}]}], ",", 
         RowBox[{"(*", "a_\[Theta]", "*)"}], 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"2", "/", "Pi"}], ")"}], " ", "as"}], "+", 
          RowBox[{"I", " ", "q", " ", "d"}]}]}], "            ", 
        RowBox[{"(*", "d_\[Theta]", "*)"}], "]"}]}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"y0", "=", 
    RowBox[{"Join", "[", 
     RowBox[{"a0", ",", "d0"}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"solY", "=", 
