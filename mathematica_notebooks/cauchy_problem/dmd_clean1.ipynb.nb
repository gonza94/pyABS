Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{"U", ",", "\[CapitalSigma]", ",", "V"}], "}"}], "=", 
    RowBox[{"SingularValueDecomposition", "[", 
     RowBox[{"Y1", ",", "r"}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[CapitalSigma]pinv", "=", 
   RowBox[{"PseudoInverse", "[", "\[CapitalSigma]", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Atilde", "=", 
    RowBox[{
     RowBox[{"ConjugateTranspose", "[", "U", "]"}], ".", "Y2", ".", "V", ".", 
     "\[CapitalSigma]pinv"}]}], ";"}], "    ", 
  RowBox[{"(*", 
   RowBox[{"r", " ", "x", " ", "r"}], "*)"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{"\[Lambda]", ",", "W"}], "}"}], "=", 
    RowBox[{"Eigensystem", "[", "Atilde", "]"}]}], ";"}], "   ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"\[Lambda]", ":", 
     RowBox[{"length", " ", "r"}]}], ",", 
    RowBox[{"W", ":", 
     RowBox[{"r", " ", "x", " ", "r", " ", 
      RowBox[{"(", 
       RowBox[{"vecs", " ", "as", " ", "rows", " ", "or", " ", 
        RowBox[{"cols", "?"}]}], ")"}]}]}]}], "*)"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[CapitalLambda]", "=", 
   RowBox[{"DiagonalMatrix", "[", "\[Lambda]", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Wmat", "=", 
    RowBox[{"Transpose", "[", "W", "]"}]}], ";"}], "            ", 
  RowBox[{"(*", 
   RowBox[{"make", " ", "eigenvectors", " ", "columns"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[CapitalPhi]", "=", 
    RowBox[{"Y2", ".", "V", ".", "\[CapitalSigma]pinv", ".", "Wmat"}]}], 
   ";"}], "            ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"2", "n"}], ")"}], " ", "x", " ", "r"}], "*)"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Omega]", "=", 
   RowBox[{
    RowBox[{"Log", "[", "\[Lambda]", "]"}], "/", 
    "\[CapitalDelta]\[Theta]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"growth", "=", 
   RowBox[{"Re", "[", "\[Omega]", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"freq", "=", 
    RowBox[{"Im", "[", "\[Omega]", "]"}]}], ";"}], "    ", 
  RowBox[{"(*", 
   RowBox[{"rad", " ", "per", " ", "theta"}], "*)"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"y1", "=", 
   RowBox[{"Y", "[", 
    RowBox[{"[", 
     RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"b", "=", 
   RowBox[{"LeastSquares", "[", 
    RowBox[{"\[CapitalPhi]", ",", "y1"}], "]"}]}], ";"}]}], "Input",
 CellLabel->
  "In[271]:=",ExpressionUUID->"712b8ad6-c9fb-4fe1-ba05-9d94d5943a4d"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"yHat", "[", "j_Integer", "]"}], ":=", 
    RowBox[{"\[CapitalPhi]", ".", 
     RowBox[{"(", 
      RowBox[{"b", "*", 
       RowBox[{"(", 
        RowBox[{"\[Lambda]", "^", "j"}], ")"}]}], ")"}]}]}], ";"}], "     ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"2", "n"}], ")"}], "-", "vector"}], "*)"}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{"example", ":", 
    RowBox[{"compare", " ", "snapshot", " ", "j"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"jtest", "=", "200"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"relErrJ", "=", 
   RowBox[{
    RowBox[{"Norm", "[", 
     RowBox[{
      RowBox[{"yHat", "[", "jtest", "]"}], "-", 
      RowBox[{"Y", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", 
         RowBox[{"jtest", "+", "1"}]}], "]"}], "]"}]}], "]"}], "/", 
    RowBox[{"Norm", "[", 
     RowBox[{"Y", "[", 
