Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", "parameters", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"w", "=", "1.0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"q", "=", "20.0"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"n", "=", 
    RowBox[{"4", "*", "256"}]}], ";"}], "                        ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"try", " ", "256", " ", "first"}], ";", 
    RowBox[{"can", " ", "raise", " ", "later"}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"sgrid", "=", 
   RowBox[{"Subdivide", "[", 
    RowBox[{"0.", ",", "1.", ",", 
     RowBox[{"n", "-", "1"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ds", "=", 
    RowBox[{
     RowBox[{"sgrid", "[", 
      RowBox[{"[", "2", "]"}], "]"}], "-", 
     RowBox[{"sgrid", "[", 
      RowBox[{"[", "1", "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", "\n", 
  
  RowBox[{"(*", 
   RowBox[{"initial", " ", "conditions"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"a0", "=", 
   RowBox[{"ConstantArray", "[", 
    RowBox[{"1.0", ",", "n"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"d0", "=", 
    RowBox[{"ConstantArray", "[", 
     RowBox[{"0.0", ",", "n"}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"2", "nd"}], "-", 
    RowBox[{"order", " ", "finite"}], "-", 
    RowBox[{"difference", " ", "derivative", " ", "in", " ", "s"}]}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Ds", "[", 
     RowBox[{"v_", "?", "VectorQ"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"dv", "=", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{"0.", ",", 
          RowBox[{"Length", "[", "v", "]"}]}], "]"}]}], "}"}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"dv", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "=", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"-", "3"}], " ", 
            RowBox[{"v", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], "+", 
           RowBox[{"4", " ", 
            RowBox[{"v", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}], "-", 
           RowBox[{"v", "[", 
            RowBox[{"[", "3", "]"}], "]"}]}], ")"}], "/", 
         RowBox[{"(", 
          RowBox[{"2", " ", "ds"}], ")"}]}]}], ";", 
       RowBox[{"(*", "forward", "*)"}], 
       RowBox[{
        RowBox[{"dv", "[", 
         RowBox[{"[", 
          RowBox[{"-", "1"}], "]"}], "]"}], "=", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"3", " ", 
            RowBox[{"v", "[", 
             RowBox[{"[", 
              RowBox[{"-", "1"}], "]"}], "]"}]}], "-", 
           RowBox[{"4", " ", 
            RowBox[{"v", "[", 
             RowBox[{"[", 
              RowBox[{"-", "2"}], "]"}], "]"}]}], "+", 
           RowBox[{"v", "[", 
            RowBox[{"[", 
             RowBox[{"-", "3"}], "]"}], "]"}]}], ")"}], "/", 
         RowBox[{"(", 
          RowBox[{"2", " ", "ds"}], ")"}]}]}], ";", 
       RowBox[{"(*", "backward", "*)"}], 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"dv", "[", 
           RowBox[{"[", "j", "]"}], "]"}], "=", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"v", "[", 
              RowBox[{"[", 
               RowBox[{"j", "+", "1"}], "]"}], "]"}], "-", 
             RowBox[{"v", "[", 
              RowBox[{"[", 
               RowBox[{"j", "-", "1"}], "]"}], "]"}]}], ")"}], "/", 
           RowBox[{"(", 
            RowBox[{"2", " ", "ds"}], ")"}]}]}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "2", ",", 
           RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}], ";", 
       RowBox[{"(*", "centered", "*)"}], "dv"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"constant", "-", 
     RowBox[{"wake", " ", "integral", " ", 
      RowBox[{"operator", ":", 
       RowBox[{"F", 
        RowBox[{"(", "s0", ")"}]}]}]}]}], "=", "0"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"FfromA", "[", 
     RowBox[{"a_", "?", "VectorQ"}], "]"}], ":=", 
    RowBox[{"w", " ", "ds", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Accumulate", "[", "a", "]"}], "-", 
       RowBox[{"a", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ")"}]}]}], ";"}], "  ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"ensures", " ", "F", 
     RowBox[{"(", "0", ")"}]}], "=", "0"}], "*)"}], "\[IndentingNewLine]", 
  "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "ODE", " ", "RHS", " ", "in", " ", "\[Theta]", " ", "for", " ", "y"}], "=", 
