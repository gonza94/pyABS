Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"--", 
     RowBox[{"--", "snapshot"}]}], " ", "times", " ", "in", " ", 
    RowBox[{
     RowBox[{"theta", "--"}], "--"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"\[Theta]ref", "=", "\[Theta]0"}], ";"}], "   ", 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"timeFactor", "[", 
      RowBox[{"k_Integer", ",", 
       RowBox[{"\[Theta]_", "?", "NumericQ"}]}], "]"}], ":=", 
     RowBox[{
      RowBox[{"b", "[", 
       RowBox[{"[", "k", "]"}], "]"}], "*", 
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"\[Omega]", "[", 
         RowBox[{"[", "k", "]"}], "]"}], "*", 
        RowBox[{"(", 
         RowBox[{"\[Theta]", "-", "\[Theta]ref"}], ")"}]}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"nTurns", "=", "23"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"\[Theta]strobes", "=", 
     RowBox[{"\[Theta]ref", "+", 
      RowBox[{"2", " ", "Pi", " ", 
       RowBox[{"Range", "[", 
        RowBox[{"0", ",", "nTurns"}], "]"}]}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"modeA", "[", "k_Integer", "]"}], ":=", 
     RowBox[{"Interpolation", "[", 
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"sgrid", ",", 
          RowBox[{"\[CapitalPhi]a", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "k"}], "]"}], "]"}]}], "}"}], "]"}], ",", 
       RowBox[{"InterpolationOrder", "->", "1"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Calculate", " ", "amplification", " ", "coefficients"}], " ", 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"amplificationks", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"modeA", "[", "l", "]"}], "[", "1", "]"}], "/", 
         RowBox[{
          RowBox[{"modeA", "[", "l", "]"}], "[", "0", "]"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"l", ",", 
         RowBox[{"Range", "[", "r", "]"}]}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"modeContribution", "[", 
      RowBox[{"k_Integer", ",", 
       RowBox[{"\[Theta]_", "?", "NumericQ"}], ",", 
       RowBox[{"s_", "?", "NumericQ"}]}], "]"}], ":=", 
     RowBox[{"Re", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"modeA", "[", "k", "]"}], "[", "s", "]"}], "*", 
       RowBox[{"timeFactor", "[", 
        RowBox[{"k", ",", "\[Theta]"}], "]"}]}], "]"}]}], ";"}]}]}]], "Input",\

