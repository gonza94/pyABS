           RowBox[{"\[Theta]", ",", "0"}], ")"}]}], "=", 
         RowBox[{
          RowBox[{"d", 
           RowBox[{"(", 
            RowBox[{"\[Theta]", ",", "1"}], ")"}]}], "=", 
          RowBox[{"0", " ", "strongly"}]}]}], "*)"}], 
       RowBox[{
        RowBox[{"d", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "=", "0."}], ";", 
       RowBox[{
        RowBox[{"d", "[", 
