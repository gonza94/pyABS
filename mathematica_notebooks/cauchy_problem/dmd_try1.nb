Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", "parameters", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"w", "=", "1.0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"q", "=", "20.0"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"n", "=", 
    RowBox[{"4", "*", "256"}]}], ";"}], "                        ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"try", " ", "256", " ", "first"}], ";", 
    RowBox[{"can", " ", "raise", " ", "later"}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"sgrid", "=", 
   RowBox[{"Subdivide", "[", 
    RowBox[{"0.", ",", "1.", ",", 
     RowBox[{"n", "-", "1"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ds", "=", 
    RowBox[{
     RowBox[{"sgrid", "[", 
      RowBox[{"[", "2", "]"}], "]"}], "-", 
     RowBox[{"sgrid", "[", 
      RowBox[{"[", "1", "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", "\n", 
  
  RowBox[{"(*", 
   RowBox[{"initial", " ", "conditions"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
