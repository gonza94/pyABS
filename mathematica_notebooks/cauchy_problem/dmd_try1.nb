Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Admd", "=", 
   RowBox[{"\[CapitalPhi]", ".", 
    RowBox[{"DiagonalMatrix", "[", "\[Lambda]", "]"}], ".", 
    RowBox[{"PseudoInverse", "[", "\[CapitalPhi]", "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"errA", "=", 
   RowBox[{
    RowBox[{"Norm", "[", 
     RowBox[{
      RowBox[{"X2", "-", 
       RowBox[{"Admd", ".", "X1"}]}], ",", "\"\<Frobenius\>\""}], "]"}], "/", 
    
    RowBox[{"Norm", "[", 
     RowBox[{"X2", ",", "\"\<Frobenius\>\""}], "]"}]}]}], 
  ";"}], "\n", "errA"}], "Input",
 CellChangeTimes->{{3.980864482619176*^9, 3.980864482622127*^9}},
 CellLabel->"In[63]:=",ExpressionUUID->"41f133aa-9b9c-4560-b482-39960e90ac35"],

