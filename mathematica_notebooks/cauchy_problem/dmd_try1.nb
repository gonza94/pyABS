    RowBox[{"ConstantArray", "[", 
     RowBox[{"0.0", ",", "n"}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"2", "nd"}], "-", 
    RowBox[{"order", " ", "finite"}], "-", 
    RowBox[{"difference", " ", "derivative", " ", "in", " ", "s"}]}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Ds", "[", 
     RowBox[{"v_", "?", "VectorQ"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"dv", "=", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{"0.", ",", 
          RowBox[{"Length", "[", "v", "]"}]}], "]"}]}], "}"}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"dv", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "=", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"-", "3"}], " ", 
            RowBox[{"v", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], "+", 
           RowBox[{"4", " ", 
            RowBox[{"v", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}], "-", 
           RowBox[{"v", "[", 
            RowBox[{"[", "3", "]"}], "]"}]}], ")"}], "/", 
         RowBox[{"(", 
          RowBox[{"2", " ", "ds"}], ")"}]}]}], ";", 
       RowBox[{"(*", "forward", "*)"}], 
       RowBox[{
        RowBox[{"dv", "[", 
         RowBox[{"[", 
          RowBox[{"-", "1"}], "]"}], "]"}], "=", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"3", " ", 
            RowBox[{"v", "[", 
             RowBox[{"[", 
              RowBox[{"-", "1"}], "]"}], "]"}]}], "-", 
           RowBox[{"4", " ", 
            RowBox[{"v", "[", 
             RowBox[{"[", 
              RowBox[{"-", "2"}], "]"}], "]"}]}], "+", 
           RowBox[{"v", "[", 
            RowBox[{"[", 
             RowBox[{"-", "3"}], "]"}], "]"}]}], ")"}], "/", 
         RowBox[{"(", 
          RowBox[{"2", " ", "ds"}], ")"}]}]}], ";", 
       RowBox[{"(*", "backward", "*)"}], 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"dv", "[", 
           RowBox[{"[", "j", "]"}], "]"}], "=", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"v", "[", 
              RowBox[{"[", 
               RowBox[{"j", "+", "1"}], "]"}], "]"}], "-", 
             RowBox[{"v", "[", 
              RowBox[{"[", 
               RowBox[{"j", "-", "1"}], "]"}], "]"}]}], ")"}], "/", 
           RowBox[{"(", 
            RowBox[{"2", " ", "ds"}], ")"}]}]}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "2", ",", 
           RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}], ";", 
       RowBox[{"(*", "centered", "*)"}], "dv"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"constant", "-", 
     RowBox[{"wake", " ", "integral", " ", 
      RowBox[{"operator", ":", 
       RowBox[{"F", 
        RowBox[{"(", "s0", ")"}]}]}]}]}], "=", "0"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"FfromA", "[", 
