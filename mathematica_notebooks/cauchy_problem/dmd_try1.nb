    RowBox[{
     RowBox[{"1", "e"}], "-", 
     RowBox[{"10", " ", "is", " ", "a", " ", "good", " ", "start"}]}]}], 
   "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"rEff", "=", 
   RowBox[{"Count", "[", 
    RowBox[{"\[Sigma]", ",", 
     RowBox[{"_", "?", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"#", ">", "tol"}], "&"}], ")"}]}]}], "]"}]}], 
  ";"}], "\n", "rEff"}], "Input",
