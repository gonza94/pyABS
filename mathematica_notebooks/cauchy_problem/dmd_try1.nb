Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"modeFun", "[", "k_Integer", "]"}], ":=", 
    RowBox[{"Interpolation", "[", 
     RowBox[{
      RowBox[{"Transpose", "[", 
       RowBox[{"{", 
        RowBox[{"sgrid", ",", 
         RowBox[{"\[CapitalPhi]", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "k"}], "]"}], "]"}]}], "}"}], "]"}], ",", 
      RowBox[{"InterpolationOrder", "->", "1"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{"Example", ":", 
    RowBox[{
    "plot", " ", "magnitude", " ", "of", " ", "a", " ", "few", " ", 
     "modes"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"Evaluate", "@", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{
        RowBox[{"modeFun", "[", "k", "]"}], "[", "s", "]"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"k", ",", "1", ",", "10"}], "}"}]}], "]"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"s", ",", "0", ",", "1"}], "}"}], ",", 
   RowBox[{"PlotLegends", "->", 
    RowBox[{"Placed", "[", 
     RowBox[{
      RowBox[{"Range", "[", "10", "]"}], ",", "Right"}], "]"}]}]}], 
  "]"}]}], "Input",
 CellChangeTimes->{{3.980860654616416*^9, 3.980860654618822*^9}, {
