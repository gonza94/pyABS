Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"jmax", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"Dimensions", "[", "Xc", "]"}], "[", 
      RowBox[{"[", "2", "]"}], "]"}], "-", "1"}]}], ";"}], "   ", 
  RowBox[{"(*", 
   RowBox[{"m", "-", 
    RowBox[{"1", " ", "if", " ", "you", " ", "built", " ", 
     RowBox[{"X1", "/", "X2"}]}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"errs", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"xtrue", "=", 
           RowBox[{"Xc", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", 
              RowBox[{"j", "+", "1"}]}], "]"}], "]"}]}], ",", 
          RowBox[{"xhat", "=", 
           RowBox[{"\[CapitalPhi]", ".", 
            RowBox[{"(", 
             RowBox[{"b", "*", 
              RowBox[{"(", 
               RowBox[{"\[Lambda]", "^", "j"}], ")"}]}], ")"}]}]}]}], "}"}], ",", 
        RowBox[{
         RowBox[{"Norm", "[", 
          RowBox[{"xhat", "-", "xtrue"}], "]"}], "/", 
         RowBox[{"Norm", "[", "xtrue", "]"}]}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", "0", ",", "jmax"}], "}"}]}], "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Min", "[", "errs", "]"}], ",", 
   RowBox[{"Median", "[", "errs", "]"}], ",", 
   RowBox[{"Max", "[", "errs", "]"}]}], "}"}], "\n", 
 RowBox[{"ListLinePlot", "[", 
  RowBox[{"errs", ",", 
   RowBox[{"PlotRange", "->", "All"}], ",", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<j\>\"", ",", "\"\<rel err\>\""}], "}"}]}]}], 
  "]"}]}], "Input",
 CellChangeTimes->{{3.98086438272825*^9, 3.980864382731242*^9}},
 CellLabel->"In[58]:=",ExpressionUUID->"3bfc9df9-5948-4840-878b-d9e469dc8c04"],

