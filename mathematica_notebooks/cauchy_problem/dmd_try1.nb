Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{"U", ",", "\[CapitalSigma]", ",", "V"}], "}"}], "=", 
    RowBox[{"SingularValueDecomposition", "[", 
     RowBox[{"Y1", ",", "r"}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[CapitalSigma]pinv", "=", 
   RowBox[{"PseudoInverse", "[", "\[CapitalSigma]", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Atilde", "=", 
    RowBox[{
     RowBox[{"ConjugateTranspose", "[", "U", "]"}], ".", "Y2", ".", "V", ".", 
     "\[CapitalSigma]pinv"}]}], ";"}], "    ", 
  RowBox[{"(*", 
   RowBox[{"r", " ", "x", " ", "r"}], "*)"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{"\[Lambda]", ",", "W"}], "}"}], "=", 
    RowBox[{"Eigensystem", "[", "Atilde", "]"}]}], ";"}], "   ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"\[Lambda]", ":", 
     RowBox[{"length", " ", "r"}]}], ",", 
    RowBox[{"W", ":", 
     RowBox[{"r", " ", "x", " ", "r", " ", 
      RowBox[{"(", 
       RowBox[{"vecs", " ", "as", " ", "rows", " ", "or", " ", 
        RowBox[{"cols", "?"}]}], ")"}]}]}]}], "*)"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[CapitalLambda]", "=", 
   RowBox[{"DiagonalMatrix", "[", "\[Lambda]", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Wmat", "=", 
    RowBox[{"Transpose", "[", "W", "]"}]}], ";"}], "            ", 
  RowBox[{"(*", 
   RowBox[{"make", " ", "eigenvectors", " ", "columns"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[CapitalPhi]", "=", 
    RowBox[{"Y2", ".", "V", ".", "\[CapitalSigma]pinv", ".", "Wmat"}]}], 
   ";"}], "            ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"2", "n"}], ")"}], " ", "x", " ", "r"}], "*)"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Omega]", "=", 
   RowBox[{
    RowBox[{"Log", "[", "\[Lambda]", "]"}], "/", 
    "\[CapitalDelta]\[Theta]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"growth", "=", 
   RowBox[{"Re", "[", "\[Omega]", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"freq", "=", 
    RowBox[{"Im", "[", "\[Omega]", "]"}]}], ";"}], "    ", 
  RowBox[{"(*", 
   RowBox[{"rad", " ", "per", " ", "theta"}], "*)"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"y1", "=", 
   RowBox[{"Y", "[", 
    RowBox[{"[", 
     RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"b", "=", 
   RowBox[{"LeastSquares", "[", 
    RowBox[{"\[CapitalPhi]", ",", "y1"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.980864848378413*^9, 
  3.98086495141829*^9}},ExpressionUUID->"6b2893ca-695d-4821-80c1-\
cdb3b4de45bf"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"yHat", "[", "j_Integer", "]"}], ":=", 
    RowBox[{"\[CapitalPhi]", ".", 
     RowBox[{"(", 
      RowBox[{"b", "*", 
       RowBox[{"(", 
        RowBox[{"\[Lambda]", "^", "j"}], ")"}]}], ")"}]}]}], ";"}], "     ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"2", "n"}], ")"}], "-", "vector"}], "*)"}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{"example", ":", 
    RowBox[{"compare", " ", "snapshot", " ", "j"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"jtest", "=", "200"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"relErrJ", "=", 
   RowBox[{
    RowBox[{"Norm", "[", 
     RowBox[{
      RowBox[{"yHat", "[", "jtest", "]"}], "-", 
      RowBox[{"Y", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", 
         RowBox[{"jtest", "+", "1"}]}], "]"}], "]"}]}], "]"}], "/", 
    RowBox[{"Norm", "[", 
     RowBox[{"Y", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", 
        RowBox[{"jtest", "+", "1"}]}], "]"}], "]"}], "]"}]}]}], 
  ";"}], "\n", "relErrJ"}], "Input",
