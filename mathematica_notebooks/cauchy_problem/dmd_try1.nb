     RowBox[{"a0", ",", "d0"}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"solY", "=", 
    RowBox[{"NDSolveValue", "[", 
