Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"xCentroidDMDVec", "[", 
     RowBox[{"\[Theta]_", "?", "NumericQ"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "timefac", "}"}], ",", 
      RowBox[{
       RowBox[{"timefac", "=", 
        RowBox[{"b", "*", 
         RowBox[{"Exp", "[", 
          RowBox[{"\[Omega]", "*", 
           RowBox[{"(", 
            RowBox[{"\[Theta]", "-", "\[Theta]ref"}], ")"}]}], "]"}]}]}], ";", 
       RowBox[{"(*", 
        RowBox[{"length", " ", "r"}], "*)"}], 
       RowBox[{"\[CapitalPhi]a", ".", "timefac"}]}]}], 
     "                          ", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"length", " ", "n"}], ",", "complex"}], "*)"}], "]"}]}], ";"}],
   "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ns", "=", "20"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Theta]strobe0", "=", "\[Theta]0"}], ";"}], "  ", 
  RowBox[{"(*", 
   RowBox[{"or", " ", "0.0"}], "*)"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Theta]strobes", "=", 
    RowBox[{"\[Theta]strobe0", "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"2", " ", "Pi"}], ")"}], " ", 
      RowBox[{
       RowBox[{"Range", "[", 
        RowBox[{"0", ",", "ns"}], "]"}], "/", "ns"}]}]}]}], ";"}], "   ", 
  RowBox[{"(*", 
   RowBox[{"ns", "+", 
    RowBox[{"1", " ", "times"}]}], "*)"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"xlcentroidstrobe", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Re", "[", 
      RowBox[{"xCentroidDMDVec", "[", 
       RowBox[{"\[Theta]strobes", "[", 
        RowBox[{"[", 
         RowBox[{"j", "+", "1"}], "]"}], "]"}], "]"}], "]"}], ",", 
     RowBox[{"(*", 
      RowBox[{"vector", " ", "length", " ", "n"}], "*)"}], 
     RowBox[{"{", 
      RowBox[{"j", ",", "0", ",", "ns"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"(*", 
