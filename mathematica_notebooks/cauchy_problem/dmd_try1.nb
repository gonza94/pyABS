}, Open  ]],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"yVec", "[", 
     RowBox[{"\[Theta]_", "?", "NumericQ"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"y", "=", 
         RowBox[{"solY", "[", "\[Theta]", "]"}]}], ",", "a", ",", "d"}], 
       "}"}], ",", 
      RowBox[{
       RowBox[{"a", "=", 
        RowBox[{"y", "[", 
         RowBox[{"[", 
          RowBox[{"1", ";;", "n"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"d", "=", 
        RowBox[{"y", "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{"n", "+", "1"}], ";;", 
           RowBox[{"2", " ", "n"}]}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"d", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "=", "0."}], ";", 
       RowBox[{
        RowBox[{"d", "[", 
         RowBox[{"[", 
          RowBox[{"-", "1"}], "]"}], "]"}], "=", "0."}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Join", "[", 
        RowBox[{"a", ",", "d"}], "]"}]}]}], "                 ", 
     RowBox[{"(*", 
      RowBox[{"size", " ", "2", "n"}], "*)"}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Y", "=", 
    RowBox[{"Transpose", "@", 
     RowBox[{"(", 
      RowBox[{"yVec", "/@", "\[Theta]list"}], ")"}]}]}], ";"}], "   ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"2", "n"}], ")"}], " ", "x", " ", "m"}], "*)"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Y1", "=", 
   RowBox[{"Y", "[", 
    RowBox[{"[", 
     RowBox[{"All", ",", 
      RowBox[{"1", ";;", 
       RowBox[{"-", "2"}]}]}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Y2", "=", 
   RowBox[{"Y", "[", 
    RowBox[{"[", 
     RowBox[{"All", ",", 
      RowBox[{"2", ";;", 
       RowBox[{"-", "1"}]}]}], "]"}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9808646954282637`*^9, 3.980864703005931*^9}},
 CellLabel->"In[66]:=",ExpressionUUID->"88e4d0fc-27c4-40a5-a76b-a60169b9dea3"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"Ufull", ",", "\[CapitalSigma]full", ",", "Vfull"}], "}"}], "=", 
   RowBox[{"SingularValueDecomposition", "[", "Y1", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Sigma]y", "=", 
   RowBox[{"Diagonal", "[", "\[CapitalSigma]full", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"cum", "=", 
   RowBox[{
    RowBox[{"Accumulate", "[", 
     RowBox[{"\[Sigma]y", "^", "2"}], "]"}], "/", 
    RowBox[{"Total", "[", 
     RowBox[{"\[Sigma]y", "^", "2"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"r", "=", 
   RowBox[{"First", "@", 
    RowBox[{"FirstPosition", "[", 
     RowBox[{"cum", ",", 
      RowBox[{"_", "?", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"#", ">=", "0.9999"}], "&"}], ")"}]}]}], "]"}]}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"ListLinePlot", "[", 
  RowBox[{"\[Sigma]y", ",", 
   RowBox[{"ScalingFunctions", "->", "\"\<Log\>\""}], ",", 
   RowBox[{"PlotRange", "->", "All"}]}], 
  "]"}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.980864761753149*^9, 3.9808648297199183`*^9}, {
  3.980864871197776*^9, 3.9808648725893917`*^9}},
 CellLabel->"In[86]:=",ExpressionUUID->"b3c3bb3a-91c3-42ec-a7a1-1656a926f9f1"],

