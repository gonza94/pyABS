Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Omega]", "=", 
   RowBox[{
    RowBox[{"Log", "[", "\[Lambda]", "]"}], "/", 
    "\[CapitalDelta]\[Theta]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Theta]ref", "=", "\[Theta]0"}], ";"}], "   ", 
  RowBox[{"(*", 
   RowBox[{"or", " ", 
    RowBox[{"\[Theta]list", "[", 
     RowBox[{"[", "1", "]"}], "]"}]}], "*)"}], "\[IndentingNewLine]"}], "\n", 

 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"timeFactor", "[", 
     RowBox[{"k_Integer", ",", 
      RowBox[{"\[Theta]_", "?", "NumericQ"}]}], "]"}], ":=", 
    RowBox[{
     RowBox[{"b", "[", 
      RowBox[{"[", "k", "]"}], "]"}], "*", 
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"\[Omega]", "[", 
        RowBox[{"[", "k", "]"}], "]"}], "*", 
       RowBox[{"(", 
        RowBox[{"\[Theta]", "-", "\[Theta]ref"}], ")"}]}], "]"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ns", "=", "16"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Theta]strobes", "=", 
    RowBox[{"\[Theta]ref", "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"2", " ", "Pi"}], ")"}], " ", 
      RowBox[{
       RowBox[{"Range", "[", 
        RowBox[{"0", ",", "ns"}], "]"}], "/", "ns"}]}]}]}], ";"}], "   ", 
  RowBox[{"(*", 
   RowBox[{"ns", "+", 
    RowBox[{
    "1", " ", "times", " ", "across", " ", "one", " ", "2", "\[Pi]", " ", 
     "period"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"nTurns", "=", "10"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Theta]strobes", "=", 
    RowBox[{"\[Theta]ref", "+", 
     RowBox[{"2", " ", "Pi", " ", 
      RowBox[{"Range", "[", 
       RowBox[{"0", ",", "nTurns"}], "]"}]}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"modeContribution", "[", 
     RowBox[{"k_Integer", ",", 
      RowBox[{"\[Theta]_", "?", "NumericQ"}], ",", 
      RowBox[{"s_", "?", "NumericQ"}]}], "]"}], ":=", 
    RowBox[{"Re", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"modeA", "[", "k", "]"}], "[", "s", "]"}], "*", 
      RowBox[{"timeFactor", "[", 
       RowBox[{"k", ",", "\[Theta]"}], "]"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.98087893581767*^9, 3.980878964381809*^9}},
 CellLabel->
  "In[168]:=",ExpressionUUID->"5d5b6110-e466-471a-a42b-bcaeba4162ed"],

