       "\[IndentingNewLine]", 
       RowBox[{"as", "=", 
        RowBox[{"Ds", "[", "a", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"ds1", "=", 
        RowBox[{"Ds", "[", "d", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"F", "=", 
        RowBox[{"FfromA", "[", "a", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "/", 
             RowBox[{"(", 
              RowBox[{"2", " ", "Pi"}], ")"}]}], ")"}], " ", "ds1"}], "+", 
          RowBox[{"I", " ", "F"}]}], ",", 
         RowBox[{"(*", "a_\[Theta]", "*)"}], 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"2", "/", "Pi"}], ")"}], " ", "as"}], "+", 
