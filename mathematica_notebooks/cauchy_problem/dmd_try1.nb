    RowBox[{"w", " ", "ds", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Accumulate", "[", "a", "]"}], "-", 
       RowBox[{"a", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ")"}]}]}], ";"}], "  ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"ensures", " ", "F", 
     RowBox[{"(", "0", ")"}]}], "=", "0"}], "*)"}], "\[IndentingNewLine]", 
  "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "ODE", " ", "RHS", " ", "in", " ", "\[Theta]", " ", "for", " ", "y"}], "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"a1", ".."}], "an"}], ",", 
      RowBox[{
       RowBox[{"d1", ".."}], "dn"}]}], "}"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"rhs", "[", 
     RowBox[{"y_", "?", "VectorQ"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"a", ",", "d", ",", "as", ",", "ds1", ",", "F"}], "}"}], ",", 
      RowBox[{
       RowBox[{"a", "=", 
        RowBox[{"y", "[", 
         RowBox[{"[", 
          RowBox[{"1", ";;", "n"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"d", "=", 
