Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"tol", "=", 
    RowBox[{
     RowBox[{"10", "^", 
      RowBox[{"-", "8"}]}], "*", 
     RowBox[{"\[Sigma]", "[", 
      RowBox[{"[", "1", "]"}], "]"}]}]}], ";"}], "   ", 
  RowBox[{"(*", 
   RowBox[{
