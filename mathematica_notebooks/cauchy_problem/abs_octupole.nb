Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"unwrap", "[", "list_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"s", "=", 
         RowBox[{"list", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ",", 
        RowBox[{"\[CurlyPhi]", "=", 
         RowBox[{"list", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ",", "d\[CurlyPhi]", ",",
         "\[CurlyPhi]u"}], "}"}], ",", 
      RowBox[{"(*", 
       RowBox[{"unwrap", " ", "jumps"}], "*)"}], 
      RowBox[{
       RowBox[{"d\[CurlyPhi]", "=", 
        RowBox[{"Differences", "[", "\[CurlyPhi]", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"d\[CurlyPhi]", "=", 
        RowBox[{"d\[CurlyPhi]", "/.", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"x_", "/;", 
             RowBox[{"x", ">", "Pi"}]}], "->", 
            RowBox[{"x", "-", 
             RowBox[{"2", " ", "Pi"}]}]}], ",", 
           RowBox[{
            RowBox[{"x_", "/;", 
             RowBox[{"x", "<", 
              RowBox[{"-", "Pi"}]}]}], "->", 
            RowBox[{"x", "+", 
             RowBox[{"2", " ", "Pi"}]}]}]}], "}"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"\[CurlyPhi]u", "=", 
        RowBox[{"Accumulate", "[", 
         RowBox[{"Prepend", "[", 
          RowBox[{"d\[CurlyPhi]", ",", 
           RowBox[{"\[CurlyPhi]", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"wrap", " ", "back", " ", "into", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "Pi"}], ",", "Pi"}]}]}], "]"}], "*)"}], 
       RowBox[{"Transpose", "@", 
        RowBox[{"{", 
         RowBox[{"s", ",", 
          RowBox[{
           RowBox[{"Mod", "[", 
            RowBox[{
             RowBox[{"\[CurlyPhi]u", "+", "Pi"}], ",", 
             RowBox[{"2", " ", "Pi"}]}], "]"}], "-", "Pi"}]}], "}"}]}]}]}], 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
