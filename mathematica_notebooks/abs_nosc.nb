96f6b46c769a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"xcentroid", " ", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"cks", "*", "xkplus"}], "+", 
      RowBox[{"cks", "*", "xkminus"}]}], " ", ")"}], "/", "2"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.964788335999535*^9, 3.9647883409689074`*^9}, {
  3.9648668167390823`*^9, 3.9648668817599707`*^9}},
 CellLabel->"In[32]:=",ExpressionUUID->"588fc5f2-164f-4526-a0fb-d7275d0d4b5a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ns", " ", "=", " ", "20"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"xcentroidstrobe", " ", "=", " ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Re", "[", 
         RowBox[{
          RowBox[{"xcentroid", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "*", 
