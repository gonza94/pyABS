    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"constants", " ", "=", " ", 
     RowBox[{"Array", "[", 
      RowBox[{"\[Alpha]", ",", 
       RowBox[{"Length", "[", "sols", "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"antheta", " ", "=", " ", 
     RowBox[{"Total", "[", 
      RowBox[{
       RowBox[{"sols", "*", "constants"}], ",", 
       RowBox[{"{", "1", "}"}]}], "]"}]}], ";"}]}]}]], "Input",
 CellLabel->"In[21]:=",ExpressionUUID->"4718e387-1158-4bed-bc67-598cb05c96d4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Get", " ", "total", " ", "solution", " ", "including", " ", "azimuthal", " ",
     "solutions"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"azimuthalsols", " ", "=", " ", 
     RowBox[{"Exp", "[", 
      RowBox[{"1.", "*", "I", "*", 
       RowBox[{"Range", "[", 
        RowBox[{
         RowBox[{"-", "size"}], ",", "size"}], "]"}], "*", "\[Psi]"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"totalsol", " ", "=", " ", 
     RowBox[{"Total", "[", 
      RowBox[{"(", 
       RowBox[{"antheta", "*", "azimuthalsols"}], ")"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Get", " ", "expression", " ", "at", " ", "\[Theta]"}], "=", 
     RowBox[{"0", " ", "to", " ", "solve", " ", "for", " ", "constants"}]}], 
    " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"totalsolzero", " ", "=", " ", 
     RowBox[{"Total", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"antheta", "*", "azimuthalsols"}], ")"}], "/.", 
       RowBox[{"{", 
        RowBox[{"\[Theta]", "->", "0"}], "}"}]}], "]"}]}], ";"}]}]}]], "Input",\

 CellLabel->"In[24]:=",ExpressionUUID->"40d749a6-0f6b-49c6-b8a7-21fc3841f6ce"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Solve", " ", "for", " ", "constants", " ", "with", " ", "constant", " ", 
    "initial", " ", "condition"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"initialcondition", " ", "=", " ", "1.0"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Psi]Vals", "=", 
     RowBox[{
      RowBox[{"Subdivide", "[", 
       RowBox[{
        RowBox[{"-", "Pi"}], ",", "Pi", ",", 
        RowBox[{
         RowBox[{"2", "*", "size"}], "+", "1"}]}], "]"}], "[", 
      RowBox[{"[", 
       RowBox[{";;", 
        RowBox[{"-", "2"}]}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"equations", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"\[Psi]Val", "\[Function]", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"totalsolzero", "/.", " ", 
            RowBox[{"\[Psi]", "->", "\[Psi]Val"}]}], ")"}], "==", 
          "initialcondition"}]}], ")"}], "/@", "\[Psi]Vals"}]}], ";"}], "//", 
    "AbsoluteTiming"}], "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"equations", " ", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"totalsolzero", "/.", 
            RowBox[{"{", 
             RowBox[{"\[Psi]", "->", "\[Psi]i"}], "}"}]}], ")"}], "==", 
          "initialcondition"}], ",", 
         RowBox[{"{", 
          RowBox[{"\[Psi]i", ",", 
           RowBox[{"-", "Pi"}], ",", "Pi", ",", 
           RowBox[{"2.", "*", 
            RowBox[{"Pi", "/", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"2.", "*", "size"}], "+", "1"}], ")"}]}]}]}], "}"}]}], 
        "]"}]}], ";"}], "//", "AbsoluteTiming"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"initialsols", " ", "=", " ", 
      RowBox[{"NSolve", "[", 
       RowBox[{"equations", ",", "constants"}], "]"}]}], ";"}], "//", 
    "AbsoluteTiming"}]}]}]], "Input",
 CellLabel->"In[27]:=",ExpressionUUID->"bc8f6e9b-5c53-4bec-aea5-d01ba75a5e52"],

