   RowBox[{
    RowBox[{
     RowBox[{"solution", "[", 
      RowBox[{"\[Theta]star_", ",", "\[Psi]star_"}], "]"}], ":=", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"totalsol", "/.", "initialsols"}], ")"}], "/.", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Theta]", "->", "\[Theta]star"}], ",", 
        RowBox[{"\[Psi]", "->", "\[Psi]star"}]}], "}"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"centroid", "[", 
      RowBox[{"\[Theta]star_", ",", "\[Psi]star_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "/", "2"}], ")"}], "*", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"solution", "[", 
         RowBox[{"\[Theta]star", ",", "\[Psi]star"}], "]"}], "+", 
        RowBox[{"solution", "[", 
         RowBox[{"\[Theta]star", ",", 
          RowBox[{"-", "\[Psi]star"}]}], "]"}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"head", "[", "\[Theta]star_", "]"}], ":=", 
     RowBox[{"Abs", "[", 
      RowBox[{"centroid", "[", 
       RowBox[{"\[Theta]star", ",", "0.0"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"tail", "[", "\[Theta]star_", "]"}], ":=", 
     RowBox[{"Abs", "[", 
      RowBox[{"centroid", "[", 
       RowBox[{"\[Theta]star", ",", "Pi"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"headtailamplification", " ", "[", "\[Theta]star_", "]"}], ":=", 
     " ", 
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{"centroid", "[", 
        RowBox[{"\[Theta]star", ",", "Pi"}], "]"}], "]"}], "/", 
      RowBox[{"Abs", "[", 
       RowBox[{"centroid", "[", 
        RowBox[{"\[Theta]star", ",", "0.0"}], "]"}], "]"}]}]}], 
    ";"}]}]}]], "Input",
