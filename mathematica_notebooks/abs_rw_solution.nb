Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Pre", "-", 
    RowBox[{
    "calculated", " ", "solution", " ", "to", " ", "RW", " ", "wake"}]}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"--", 
      RowBox[{"-", "RW"}]}], " ", "square"}], "-", 
    RowBox[{"well", " ", "matrix", " ", "element", " ", "U_nm", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"all", " ", "integers", " ", "n"}], ",", 
        RowBox[{"m", " ", 
         RowBox[{"incl", ".", "0"}]}]}], ")"}], "--"}]}], "-"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{"unm", ",", "unmBase", ",", "Sfac", ",", "Cfac"}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Fresnel", " ", "helper", " ", "factors"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Sfac", "[", 
      RowBox[{"k_Integer", "?", "Positive"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"Sfac", "[", "k", "]"}], "=", 
      RowBox[{
       RowBox[{"Sqrt", "[", 
        RowBox[{"2", "/", "k"}], "]"}], " ", 
       RowBox[{"FresnelS", "[", 
        RowBox[{"Sqrt", "[", 
         RowBox[{"2", " ", "k"}], "]"}], "]"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Cfac", "[", 
      RowBox[{"k_Integer", "?", "Positive"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"Cfac", "[", "k", "]"}], "=", 
      RowBox[{
       RowBox[{"Sqrt", "[", 
        RowBox[{"2", "/", "k"}], "]"}], " ", 
       RowBox[{"FresnelC", "[", 
        RowBox[{"Sqrt", "[", 
         RowBox[{"2", " ", "k"}], "]"}], "]"}]}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"--", "Base"}]}], " ", "formulas", " ", "for", " ", 
      "nonnegative", " ", "indices", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"nn", ",", 
          RowBox[{"mm", ">=", "0"}]}], ")"}], "--"}], "--"}], " ", "\[IndentingNewLine]",
       "These", " ", "are", " ", "the", " ", "analytic", " ", "RW", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"W", "~", "1"}], "/", 
        RowBox[{"Sqrt", "[", 
         RowBox[{"s", "-", 
          RowBox[{"s", "'"}]}], "]"}]}], ")"}], " ", "square"}], "-", 
     RowBox[{"well", " ", 
      RowBox[{"results", "."}]}]}], "\[IndentingNewLine]", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"unmBase", "[", 
      RowBox[{
       RowBox[{"nn_Integer", "?", "NonNegative"}], ",", 
       RowBox[{"mm_Integer", "?", "NonNegative"}]}], "]"}], ":=", 
     RowBox[{"Which", "[", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"U_", "00"}], "=", 
        RowBox[{"4", "/", "3"}]}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"nn", "==", "0"}], "&&", 
        RowBox[{"mm", "==", "0"}]}], ",", 
       RowBox[{"4", "/", "3"}], ",", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"U_", "0", "m"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"nn", "==", "0"}], "&&", 
        RowBox[{"mm", ">", "0"}]}], ",", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"-", "1"}], ")"}], "^", "mm"}], ")"}], "/", 
           RowBox[{"(", 
            RowBox[{"Pi", " ", "*", "mm"}], ")"}]}], ")"}]}], "*", 
        RowBox[{"Sfac", "[", "mm", "]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"(*", "U_n0", "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"mm", "==", "0"}], "&&", 
        RowBox[{"nn", ">", "0"}]}], ",", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"(", 
          RowBox[{"1", "/", 
           RowBox[{"(", 
            RowBox[{"Pi", " ", "nn"}], ")"}]}], ")"}]}], "*", 
        RowBox[{"Sfac", "[", "nn", "]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"diagonal", " ", "n"}], "=", 
         RowBox[{"n", ">=", "1"}]}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"nn", "==", "mm"}], "&&", 
        RowBox[{"nn", ">", "0"}]}], ",", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "/", "2"}], ")"}], "*", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Cfac", "[", "nn", "]"}], "-", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "/", 
             RowBox[{"(", 
              RowBox[{"Pi", "*", "nn"}], ")"}]}], ")"}], "*", 
           RowBox[{"Sfac", "[", "nn", "]"}]}]}], ")"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"off", "-", 
         RowBox[{"diagonal", " ", "for", " ", "positive", " ", "indices"}]}], 
        "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"nn", ">", "0"}], "&&", 
        RowBox[{"mm", ">", "0"}]}], ",", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "/", 
          RowBox[{"(", 
           RowBox[{"2", " ", "Pi"}], ")"}]}], ")"}], "*", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"-", "1"}], ")"}], "^", 
                RowBox[{"(", 
                 RowBox[{"nn", "-", "mm"}], ")"}]}], ")"}], "/", 
              RowBox[{"(", 
               RowBox[{"nn", "-", "mm"}], ")"}]}], "+", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"-", "1"}], ")"}], "^", 
                RowBox[{"(", 
                 RowBox[{"nn", "+", "mm", "+", "1"}], ")"}]}], ")"}], "/", 
              RowBox[{"(", 
               RowBox[{"nn", "+", "mm"}], ")"}]}]}], ")"}], "*", 
           RowBox[{"Sfac", "[", "mm", "]"}]}], "-", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"1", "/", 
               RowBox[{"(", 
                RowBox[{"nn", "-", "mm"}], ")"}]}], "+", 
              RowBox[{"1", "/", 
               RowBox[{"(", 
                RowBox[{"nn", "+", "mm"}], ")"}]}]}], ")"}], ")"}], "*", 
           RowBox[{"Sfac", "[", "nn", "]"}]}]}], ")"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"--", "Full"}]}], " ", "symmetry", " ", "extension", " ", "to",
       " ", "all", " ", 
      RowBox[{
       RowBox[{"integers", "--"}], "--"}], " ", 
      RowBox[{"Uses", ":", "U_nm"}]}], "=", 
     RowBox[{
      RowBox[{"U_", "|", 
       RowBox[{"n", "||", "m"}], "|", 
       RowBox[{"and", " ", "U_nm"}]}], "=", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"-", "1"}], ")"}], "^", 
        RowBox[{"(", 
         RowBox[{"n", "-", "m"}], ")"}]}], " ", "U_mn", " ", "We", " ", 
       "implement", " ", "by", " ", "mapping", " ", "to", " ", "abs", " ", 
       "indices", " ", "and", " ", "using", " ", "one", " ", 
       RowBox[{"triangle", "."}]}]}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"unm", "[", 
      RowBox[{"n_Integer", ",", "m_Integer"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"nn", "=", 
          RowBox[{"Abs", "[", "n", "]"}]}], ",", 
         RowBox[{"mm", "=", 
          RowBox[{"Abs", "[", "m", "]"}]}]}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"Which", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"nn", "==", "mm"}], ",", 
         RowBox[{"unmBase", "[", 
          RowBox[{"nn", ",", "mm"}], "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"nn", ">", "mm"}], ",", 
         RowBox[{"unmBase", "[", 
          RowBox[{"nn", ",", "mm"}], "]"}], ",", "\[IndentingNewLine]", 
         "True", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"-", "1"}], ")"}], "^", 
           RowBox[{"(", 
            RowBox[{"nn", "-", "mm"}], ")"}]}], "*", 
          RowBox[{"unmBase", "[", 
           RowBox[{"mm", ",", "nn"}], "]"}]}]}], "\[IndentingNewLine]", 
        "]"}]}], "\[IndentingNewLine]", "]"}]}], ";"}], "\n"}]}]], "Input",
 CellChangeTimes->{{3.9754104693072767`*^9, 3.975410490172964*^9}, {
   3.975410809490275*^9, 3.9754108301384478`*^9}, {3.9754113935489893`*^9, 
