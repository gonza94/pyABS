    "AbsoluteTiming"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"paired", " ", "=", " ", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"eigenvals", ",", "eigenvects"}], "}"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
